# Copia este archivo a .env y completa los valores.
# Ninguna de estas variables tiene un valor por defecto: si falta una, la app no arranca.
DB_HOST=localhost
DB_PORT=5433
DB_USER=vacante
# La base local que levanta docker-compose.yml NO usa contraseña: se crea con auth "trust" y
# solo escucha en 127.0.0.1, así que no es alcanzable desde la red. Esta variable tiene que
# existir y no estar vacía porque la app la valida al arrancar, pero contra la base local no se
# usa. En un servidor de verdad, acá va la contraseña real, y ese .env NO se versiona.
DB_PASSWORD=sin-uso-local
DB_NAME=vacante
PORT=3000
